Package: SpaTopic
Type: Package
Title: Topic Inference to Identify Tissue Architecture in Multiplexed Images
Version: 1.3.1.9000
Date: 2026-05-27
Authors@R: c(
  person("Xiyu", "Peng", email = "pansypeng124@gmail.com",
    role = c("aut", "cre"),comment = c(ORCID = "0000-0003-4232-0910")),
  person("Nikki", "Xiao", email = "xmq041117@gmail.com",
